{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novelnest-narration",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "ai": { "binding": "AI" },
  "observability": { "enabled": false },
  "ratelimits": [
    { "name": "REQUEST_LIMIT", "namespace_id": "9201", "simple": { "limit": 12, "period": 60 } }
  ]
}
